<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/08_UI%20Toolkit/Common_StyleSheet.uss?fileID=7433441132597879392&amp;guid=0a300e270a3adf84e9ec54025e2a36ed&amp;type=3#Common_StyleSheet"/>
    <Style src="project://database/Assets/08_UI%20Toolkit/LoadingScreen_StyleSheet.uss?fileID=7433441132597879392&amp;guid=ebb5ac94459a5de4faa7303f5d3becf8&amp;type=3#LoadingScreen_StyleSheet"/>
    <ui:VisualElement name="LoadingScreen" style="flex-grow: 1; align-items: center; transition-duration: 0.2s;">
        <ui:VisualElement style="flex-grow: 1; height: 100%; width: 50%; justify-content: center; align-items: stretch; padding-top: 10%;">
            <ui:Label text="Level 1" name="LevelNumber" class="header" style="-unity-font-style: bold; -unity-text-align: upper-center; font-size: 60px; padding-bottom: 15%; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-left: 0;"/>
            <ui:VisualElement name="VisualElement" style="flex-grow: 0; height: 20%; width: 100%; justify-content: space-around; align-items: center; align-self: stretch; align-content: center;">
                <ui:Slider name="LoadingBar" fill="true" high-value="100" value="0" focusable="false" enabled="true" direction="Horizontal" style="margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; height: 50%; padding-top: 0%; padding-right: 0%; padding-bottom: 0%; padding-left: 0%; justify-content: center; -unity-text-align: middle-left; align-self: stretch; align-items: center; align-content: center; position: absolute; flex-grow: 0; width: 100%; flex-shrink: 1; top: 0%; right: 0%; bottom: 0%; left: 0%; min-height: 50%;"/>
                <ui:Label text="Loading..." name="Loading" class="header" style="-unity-font-style: bold; -unity-text-align: upper-left; font-size: 40px; margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; top: 25%;"/>
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
