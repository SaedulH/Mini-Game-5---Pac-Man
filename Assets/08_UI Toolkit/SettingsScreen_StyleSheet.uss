#SettingsTabs Label {
    color: rgb(215, 184, 24);
    font-size: 30px;
}

#SettingsTabs Button:hover {
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    transition-duration: 0.2s;
    scale: 1.2 1.2 1.2;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-top-left-radius: 2px;
    border-top-right-radius: 2px;
    border-bottom-right-radius: 2px;
    border-bottom-left-radius: 2px;
}

#SettingsTabs Button:active {
    transition-duration: 0.1s;
    scale: 0.95 0.95;
}

#SettingsTabs Button:disabled {
    transition-duration: 0.2s;
    scale: 1.2 1.2 1.2;
    -unity-background-image-tint-color: rgb(255, 228, 0);
    text-shadow: 5px 0 0 rgb(255, 255, 255);
    color: rgb(0, 0, 0);
}

.audioSlider {
    width: 70%;
    -unity-text-align: middle-left;
    -unity-font-style: normal;
    color: rgb(217, 217, 217);
    -unity-font: url("project://database/Assets/TextMesh%20Pro/Fonts/Nulshock%20Bd.otf?fileID=12800000&guid=12768c2c754fbf248846c9b6df869991&type=3#Nulshock Bd");
    text-overflow: clip;
    white-space: nowrap;
    font-size: 22px;
    flex-direction: column;
    -unity-font-definition: initial;
    letter-spacing: 20px;
    height: 100%;
    align-items: stretch;
    display: flex;
    flex-grow: 0;
    margin-left: 5%;
}

#Audio SliderInt #unity-drag-container {
    align-self: center;
    justify-content: center;
    align-items: stretch;
    align-content: center;
}

#Audio SliderInt #unity-tracker {
    opacity: 1;
}

#Audio SliderInt #unity-dragger {
    opacity: 1;
}

#Audio SliderInt #unity-fill {
}

#Audio SliderInt #unity-text-field {
    border-left-color: rgb(255, 230, 0);
    border-right-color: rgb(255, 230, 0);
    border-top-color: rgb(255, 230, 0);
    border-bottom-color: rgb(255, 230, 0);
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-top-left-radius: 12px;
    border-top-right-radius: 12px;
    border-bottom-right-radius: 12px;
    border-bottom-left-radius: 12px;
    width: 8%;
}

#Audio SliderInt #unity-text-input {
    background-color: rgba(0, 0, 0, 0);
    -unity-font-definition: url("project://database/Assets/08_UI%20Toolkit/Font/Emulogic-zrEw.ttf?fileID=12800000&guid=3e5d93a06c3e9bd4db5025f0b5391d22&type=3#Emulogic-zrEw");
    -unity-text-align: middle-center;
}

.controlMapping {
    align-items: stretch;
    align-content: center;
    align-self: stretch;
    justify-content: space-between;
    width: 100%;
    height: 100%;
}

.controlText {
    margin-right: 0%;
    margin-left: 5%;
    -unity-font-definition: url("project://database/Assets/08_UI%20Toolkit/Font/Emulogic-zrEw.ttf?fileID=12800000&guid=3e5d93a06c3e9bd4db5025f0b5391d22&type=3#Emulogic-zrEw");
    color: rgb(183, 183, 183);
    font-size: 35px;
    -unity-text-align: middle-left;
}

.controlInput {
    -unity-font-definition: url("project://database/Assets/TextMesh%20Pro/Fonts/Nulshock%20Bd.otf?fileID=12800000&guid=12768c2c754fbf248846c9b6df869991&type=3#Nulshock Bd");
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    border-top-width: 5px;
    border-right-width: 5px;
    border-bottom-width: 5px;
    border-left-width: 5px;
    border-top-left-radius: 15px;
    border-top-right-radius: 15px;
    border-bottom-right-radius: 15px;
    border-bottom-left-radius: 15px;
    border-left-color: rgba(255, 242, 0, 0.2);
    border-right-color: rgba(255, 242, 0, 0.2);
    border-top-color: rgba(255, 242, 0, 0.2);
    border-bottom-color: rgba(255, 242, 0, 0.2);
    background-color: rgba(255, 246, 0, 0.66);
    background-image: none;
    -unity-background-scale-mode: scale-and-crop;
    -unity-slice-type: sliced;
    -unity-background-image-tint-color: rgba(20, 23, 67, 0.39);
    font-size: 45px;
    color: rgb(183, 183, 183);
    width: 40%;
    margin-right: 10%;
}

.controlInput:hover {
    scale: 1.15 1.15;
    color: rgb(0, 148, 255);
    transition-duration: 0.15s;
    border-left-color: rgb(0, 148, 255);
    border-right-color: rgb(0, 148, 255);
    border-top-color: rgb(0, 148, 255);
    border-bottom-color: rgb(0, 148, 255);
    background-color: rgba(0, 112, 176, 0.59);
    -unity-background-image-tint-color: rgba(20, 23, 67, 0.59);
    -unity-slice-type: sliced;
    -unity-slice-left: 0;
    -unity-slice-top: 20;
    -unity-slice-right: 0;
    -unity-slice-bottom: 20;
}

.controlInput:active {
    scale: 0.9 0.9;
    -unity-background-image-tint-color: rgba(20, 23, 67, 0.78);
    background-color: rgba(0, 112, 176, 0.59);
    transition-duration: 0.05s;
}

.inputPopupText {
    align-self: center;
    align-items: center;
    font-size: 40px;
    color: rgb(183, 183, 183);
    -unity-font: url("project://database/Assets/TextMesh%20Pro/Fonts/Nulshock%20Bd.otf?fileID=12800000&guid=12768c2c754fbf248846c9b6df869991&type=3#Nulshock Bd");
    -unity-font-style: normal;
    margin-top: 10px;
    margin-bottom: 10px;
    -unity-font-definition: initial;
}

TabView #unity-tab-view__content-container {
    flex-grow: 1;
    width: 100%;
    opacity: 1;
    align-items: center;
    height: 100%;
}

TabView #unity-tab__content-container {
    -unity-font-definition: url("project://database/Assets/08_UI%20Toolkit/Font/Emulogic-zrEw.ttf?fileID=12800000&guid=3e5d93a06c3e9bd4db5025f0b5391d22&type=3#Emulogic-zrEw");
    width: 80%;
    height: 100%;
    align-items: center;
    justify-content: center;
}

TabView .unity-toggle-button-group {
    justify-content: space-evenly;
    align-items: center;
    align-self: stretch;
    align-content: center;
    flex-grow: 1;
    width: 100%;
    overflow: visible;
}

TabView .unity-toggle-button-group Label {
    width: 30%;
    font-size: 35px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    white-space: normal;
    -unity-text-align: middle-left;
    text-overflow: clip;
}

TabView .unity-toggle-button-group .unity-button-group {
    justify-content: center;
    align-self: stretch;
    align-items: center;
    flex-direction: row;
    align-content: auto;
    width: 70%;
    overflow: visible;
}

#Game ToggleButtonGroup Button {
    background-color: rgba(0, 0, 0, 0);
    margin-right: 2.5%;
    margin-left: 2.5%;
    padding-right: 2.5%;
    padding-left: 2.5%;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    transition-duration: 0.2s;
    width: 30%;
    height: 45%;
}

#Game #unity-toggle-button-group__container {
    justify-content: center;
    flex-direction: row;
}

TabView #unity-tab__header-label {
    margin-bottom: 0%;
    transition-duration: 0.15s;
    -unity-font-definition: url("project://database/Assets/08_UI%20Toolkit/Font/Emulogic-zrEw.ttf?fileID=12800000&guid=3e5d93a06c3e9bd4db5025f0b5391d22&type=3#Emulogic-zrEw");
    color: rgb(63, 63, 63);
    -unity-font-style: bold;
    font-size: 30px;
    background-image: url("project://database/Assets/05_Sprites/RetroButtonHD.png?fileID=21300000&guid=16badd43ec4118046b2926eb6fa5e092&type=3#RetroButtonHD");
    margin-top: 0%;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
    height: 100%;
    text-shadow: 0 -5px 0 rgb(255, 255, 255);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.78);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    margin-right: 2.5%;
    margin-left: 2.5%;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    width: 100%;
}

TabView #unity-tab__header-label:hover {
    transition-duration: 0.2s;
    scale: 1.2 1.2 1.2;
    -unity-background-image-tint-color: rgb(255, 228, 0);
    text-shadow: 5px 0 0 rgb(255, 255, 255);
    color: rgb(0, 0, 0);
}

TabView RepeatButton {
    display: none;
    opacity: 0;
    visibility: hidden;
}

TabView .unity-tab-view__content-viewport {
    width: 75%;
    align-items: center;
    align-content: center;
    align-self: center;
    justify-content: center;
    flex-grow: 0;
    height: 15%;
    opacity: 1;
    visibility: visible;
    display: flex;
    overflow: visible;
    margin-bottom: 2.5%;
}

TabView #unity-tab-view__header-container {
    width: 100%;
    align-items: center;
    align-self: center;
    justify-content: space-evenly;
    flex-direction: row;
    height: 80%;
}

TabView #unity-tab__header {
    align-items: center;
    justify-content: center;
    transition-duration: 0.2s;
    margin-right: 10%;
    margin-left: 10%;
    background-color: rgba(0, 0, 0, 0);
    height: 100%;
    width: 30%;
}

TabView #unity-tab__header:checked Label {
    transition-duration: 0.2s;
    scale: 1.1 1.1 1.1;
    -unity-background-image-tint-color: rgb(255, 200, 0);
    text-shadow: 5px 0 0 rgb(255, 255, 255);
    color: rgb(0, 0, 0);
}

TabView #unity-tab__header-underline {
    opacity: 0;
}

.selectionButton {
    margin-bottom: 2.5%;
    transition-duration: 0.15s;
    -unity-font-definition: url("project://database/Assets/08_UI%20Toolkit/Font/Emulogic-zrEw.ttf?fileID=12800000&guid=3e5d93a06c3e9bd4db5025f0b5391d22&type=3#Emulogic-zrEw");
    color: rgb(63, 63, 63);
    -unity-font-style: bold;
    font-size: 25px;
    background-image: url("project://database/Assets/05_Sprites/RetroButtonHD.png?fileID=21300000&guid=16badd43ec4118046b2926eb6fa5e092&type=3#RetroButtonHD");
    margin-top: 2.5%;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
    height: 50%;
    text-shadow: 0 -5px 0 rgb(255, 255, 255);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.78);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    width: 25%;
    scale: 0.95 0.95 0.95;
}

.selectedButton {
    transition-duration: 0.15s;
    scale: 1.2 1.2 1.2;
    -unity-background-image-tint-color: rgb(255, 200, 0);
    text-shadow: 5px 0 0 rgb(255, 255, 255);
    color: rgb(0, 0, 0);
    width: 25%;
    height: 50%;
    margin-top: 2.5%;
    margin-bottom: 2.5%;
    -unity-font-definition: url("project://database/Assets/08_UI%20Toolkit/Font/Emulogic-zrEw.ttf?fileID=12800000&guid=3e5d93a06c3e9bd4db5025f0b5391d22&type=3#Emulogic-zrEw");
    font-size: 25px;
    background-image: url("project://database/Assets/05_Sprites/RetroButtonHD.png?fileID=21300000&guid=16badd43ec4118046b2926eb6fa5e092&type=3#RetroButtonHD");
    background-color: rgba(0, 0, 0, 0);
}

.selectionButton:hover {
    transition-duration: 0.2s;
    scale: 1.2 1.2 1.2;
    -unity-background-image-tint-color: rgb(255, 228, 0);
    text-shadow: 5px 0 0 rgb(255, 255, 255);
    color: rgb(0, 0, 0);
}

.selectionButton:active {
    transition-duration: 0.1s;
    scale: 0.95 0.95;
    -unity-background-image-tint-color: rgb(255, 200, 0);
}

.footerButton {
    margin-bottom: 0%;
    transition-duration: 0.15s;
    -unity-font-definition: url("project://database/Assets/08_UI%20Toolkit/Font/Emulogic-zrEw.ttf?fileID=12800000&guid=3e5d93a06c3e9bd4db5025f0b5391d22&type=3#Emulogic-zrEw");
    color: rgb(63, 63, 63);
    -unity-font-style: bold;
    font-size: 30px;
    background-image: url("project://database/Assets/05_Sprites/RetroButtonHD.png?fileID=21300000&guid=16badd43ec4118046b2926eb6fa5e092&type=3#RetroButtonHD");
    margin-top: 0%;
    -unity-text-align: middle-center;
    background-color: rgba(0, 0, 0, 0);
    height: 40%;
    text-shadow: 0 -5px 0 rgb(255, 255, 255);
    -unity-background-image-tint-color: rgba(255, 255, 255, 0.78);
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
    margin-right: 2.5%;
    margin-left: 2.5%;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    width: 20%;
}

.footerButton:hover {
    transition-duration: 0.2s;
    scale: 1.2 1.2 1.2;
    -unity-background-image-tint-color: rgb(255, 228, 0);
    text-shadow: 5px 0 0 rgb(255, 255, 255);
    color: rgb(0, 0, 0);
}

.footerButton:active {
    transition-duration: 0.1s;
    scale: 0.95 0.95;
}
